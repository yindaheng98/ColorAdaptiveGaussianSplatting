{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "train",
            "type": "debugpy",
            "request": "launch",
            "module": "reduced_3dgs.train",
            "console": "integratedTerminal",
            "justMyCode": false,
            "args": [
                "-s",
                "data/truck",
                "-d",
                "output/truck-reduced",
                "-i",
                "30000",
                "--mode",
                "densify-prune-shculling",
            ]
        },
        {
            "name": "quantize",
            "type": "debugpy",
            "request": "launch",
            "module": "reduced_3dgs.quantize",
            "console": "integratedTerminal",
            "justMyCode": false,
            "args": [
                "-s",
                "output/truck-reduced",
                "-d",
                "output/truck-quantized",
                "-i",
                "30000",
                "--num_clusters_scaling=1024",
                "--num_clusters_rotation_re=256",
                "--num_clusters_rotation_im=1024",
                "--num_clusters_opacity=256",
                "--num_clusters_features_dc=512",
                "--num_clusters_features_rest=256",
            ]
        },
        {
            "name": "scalable quantize",
            "type": "debugpy",
            "request": "launch",
            "module": "cags.quantize",
            "console": "integratedTerminal",
            "justMyCode": false,
            "args": [
                "-s",
                "output/truck",
                "-d",
                "output/truck-scalable",
                "-i",
                "30000",
                "-onum_clusters_scaling=1024",
                "-on_bits_proposal_scaling=n_bits_proposal_balanced_values(8)",
                "-onum_clusters_rotation_re=256",
                "-on_bits_proposal_rotation_re=n_bits_proposal_balanced_values(6)",
                "-onum_clusters_rotation_im=1024",
                "-on_bits_proposal_rotation_im=n_bits_proposal_balanced_values(8)",
                "-onum_clusters_opacity=256",
                "-on_bits_proposal_opacity=n_bits_proposal_balanced_values(6)",
                "-onum_clusters_features_dc=512",
                "-on_bits_proposal_features_dc=n_bits_proposal_balanced_values(7)",
                "-onum_clusters_features_rest=[256, 128, 64]",
                "-on_bits_proposal_features_rest=[n_bits_proposal_balanced_values(6), n_bits_proposal_balanced_values(5), n_bits_proposal_balanced_values(4)]",
            ]
        },
        {
            "name": "scalable dequantize",
            "type": "debugpy",
            "request": "launch",
            "module": "cags.quantize",
            "console": "integratedTerminal",
            "justMyCode": false,
            "args": [
                "-s",
                "output/truck",
                "-d",
                "output/truck-scalable",
                "-i",
                "30000",
                "--dequantize",
            ]
        },
        {
            "name": "draco to 3dgs",
            "type": "debugpy",
            "request": "launch",
            "program": "tools/draco_to_3dgs.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "args": [
                "-d",
                "output/truck-draco",
                "--sh_degree",
                "3",
                "--iteration",
                "30000",
            ]
        },
    ]
}