{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "train",
            "type": "debugpy",
            "request": "launch",
            "module": "reduced_3dgs.train",
            "console": "integratedTerminal",
            "justMyCode": false,
            "args": [
                "-s",
                "data/truck",
                "-d",
                "output/truck-reduced",
                "-i",
                "30000",
                "--mode",
                "camera-densify-prune-shculling",
            ]
        },
        {
            "name": "quantize dequantize",
            "type": "debugpy",
            "request": "launch",
            "module": "cags.quantize",
            "console": "integratedTerminal",
            "justMyCode": false,
            "args": [
                "-s",
                "output/truck-reduced",
                "-d",
                "output/truck-scalable",
                "-i",
                "30000",
                "--draco",
                // "--dequantize",
                "-onum_clusters_scaling=1024",
                "-on_bits_proposal_scaling=n_bits_proposal_balanced_values(8)",
                "-onum_clusters_rotation_re=256",
                "-on_bits_proposal_rotation_re=n_bits_proposal_balanced_values(6)",
                "-onum_clusters_rotation_im=1024",
                "-on_bits_proposal_rotation_im=n_bits_proposal_balanced_values(8)",
                "-onum_clusters_opacity=256",
                "-on_bits_proposal_opacity=n_bits_proposal_balanced_values(6)",
                "-onum_clusters_features_dc=512",
                "-on_bits_proposal_features_dc=n_bits_proposal_balanced_values(7)",
                "-onum_clusters_features_rest=[256, 128, 64]",
                "-on_bits_proposal_features_rest=[n_bits_proposal_balanced_values(6), n_bits_proposal_balanced_values(5), n_bits_proposal_balanced_values(4)]",
            ]
        },
        {
            "name": "pickup quantized",
            "type": "debugpy",
            "request": "launch",
            "module": "cags.pickup",
            "console": "integratedTerminal",
            "justMyCode": false,
            "args": [
                "-s",
                "output/truck-scalable",
                "-d",
                "output/truck-scalable-pickup",
                "-i",
                "30000",
                "--draco",
                "--pickup_sh_degree=1",
                "-lfeatures_dc=2",
                "-lfeatures_rest_0=2",
                "-lfeatures_rest_1=2",
                "-lfeatures_rest_2=2",
                "-lopacity=3",
                "-lrotation_im=3",
                "-lrotation_re=2",
                "-lscaling=3",
                "-on_bit_baselayer=6",
                "-onum_clusters_scaling=2048",
                "-on_bits_proposal_scaling=n_bits_proposal_balanced_values(8)",
                "-onum_clusters_rotation_re=256",
                "-on_bits_proposal_rotation_re=n_bits_proposal_balanced_values(6)",
                "-onum_clusters_rotation_im=1024",
                "-on_bits_proposal_rotation_im=n_bits_proposal_balanced_values(8)",
                "-onum_clusters_opacity=256",
                "-on_bits_proposal_opacity=n_bits_proposal_balanced_values(6)",
                "-onum_clusters_features_dc=512",
                "-on_bits_proposal_features_dc=n_bits_proposal_balanced_values(7)",
                "-onum_clusters_features_rest=[256, 128, 64]",
                "-on_bits_proposal_features_rest=[n_bits_proposal_balanced_values(6), n_bits_proposal_balanced_values(5), n_bits_proposal_balanced_values(4)]",
            ]
        },
        {
            "name": "render pickup",
            "type": "debugpy",
            "request": "launch",
            "module": "cags.render",
            "console": "integratedTerminal",
            "justMyCode": false,
            "args": [
                "-s",
                "data/truck",
                "-d",
                "output/truck-scalable-pickup",
                "-i",
                "30000",
                "--mode",
                "base",
                "--load_camera",
                "output/truck-scalable-pickup/cameras.json",
            ]
        },
        {
            "name": "tile stitch",
            "type": "debugpy",
            "request": "launch",
            "module": "cags.tile",
            "console": "integratedTerminal",
            "justMyCode": false,
            "args": [
                "-s",
                "output/truck-reduced",
                "-d",
                "output/truck-scalable-tiles",
                "-i",
                "30000",
                "--draco",
                // "--stitching",
                "-on_bit_baselayer=6",
                "-onum_clusters_scaling=2048",
                "-on_bits_proposal_scaling=n_bits_proposal_balanced_values(8)",
                "-onum_clusters_rotation_re=256",
                "-on_bits_proposal_rotation_re=n_bits_proposal_balanced_values(6)",
                "-onum_clusters_rotation_im=1024",
                "-on_bits_proposal_rotation_im=n_bits_proposal_balanced_values(8)",
                "-onum_clusters_opacity=256",
                "-on_bits_proposal_opacity=n_bits_proposal_balanced_values(6)",
                "-onum_clusters_features_dc=512",
                "-on_bits_proposal_features_dc=n_bits_proposal_balanced_values(7)",
                "-onum_clusters_features_rest=[256, 128, 64]",
                "-on_bits_proposal_features_rest=[n_bits_proposal_balanced_values(6), n_bits_proposal_balanced_values(5), n_bits_proposal_balanced_values(4)]",
            ]
        },
        {
            "name": "encode decode",
            "type": "debugpy",
            "request": "launch",
            "module": "cags.encode",
            "console": "integratedTerminal",
            "justMyCode": false,
            "args": [
                "-s",
                "output/coffee_martini/refine/masked-propagate-dot-cotracker3",
                "-d",
                "output/coffee_martini-compressed/refine/masked-propagate-dot-cotracker3",
                "-i",
                "1000",
                "--source_init",
                "output/coffee_martini/frame1",
                "--destination_init",
                "output/coffee_martini-compressed/frame1",
                "--iteration_init",
                "10000",
                "--frame_start",
                "2",
                "--frame_end",
                "300",
                "--draco",
                // "--decode",
                // "--no_tiling_rest",
                "-on_bit_baselayer=6",
                "-onum_clusters_scaling=2048",
                "-on_bits_proposal_scaling=n_bits_proposal_balanced_values(8)",
                "-onum_clusters_rotation_re=256",
                "-on_bits_proposal_rotation_re=n_bits_proposal_balanced_values(6)",
                "-onum_clusters_rotation_im=1024",
                "-on_bits_proposal_rotation_im=n_bits_proposal_balanced_values(8)",
                "-onum_clusters_opacity=256",
                "-on_bits_proposal_opacity=n_bits_proposal_balanced_values(6)",
                "-onum_clusters_features_dc=512",
                "-on_bits_proposal_features_dc=n_bits_proposal_balanced_values(7)",
                "-onum_clusters_features_rest=[256, 128, 64]",
                "-on_bits_proposal_features_rest=[n_bits_proposal_balanced_values(6), n_bits_proposal_balanced_values(5), n_bits_proposal_balanced_values(4)]",
            ]
        },
        {
            "name": "encode decode no interframe",
            "type": "debugpy",
            "request": "launch",
            "module": "cags.encode",
            "console": "integratedTerminal",
            "justMyCode": false,
            "args": [
                "-s",
                "output/coffee_martini/refine/masked-propagate-dot-cotracker3",
                "-d",
                "output/coffee_martini-nointerframe/refine/masked-propagate-dot-cotracker3",
                "-i",
                "1000",
                "--source_init",
                "output/coffee_martini/frame1",
                "--destination_init",
                "output/coffee_martini-nointerframe/frame1",
                "--iteration_init",
                "10000",
                "--frame_start",
                "2",
                "--frame_end",
                "300",
                "--draco",
                // "--decode",
                "--no_tiling_first",
                "--no_tiling_rest",
                "--interframe",
                "none",
                "-on_bit_baselayer=6",
                "-onum_clusters_scaling=2048",
                "-on_bits_proposal_scaling=n_bits_proposal_balanced_values(8)",
                "-onum_clusters_rotation_re=256",
                "-on_bits_proposal_rotation_re=n_bits_proposal_balanced_values(6)",
                "-onum_clusters_rotation_im=1024",
                "-on_bits_proposal_rotation_im=n_bits_proposal_balanced_values(8)",
                "-onum_clusters_opacity=256",
                "-on_bits_proposal_opacity=n_bits_proposal_balanced_values(6)",
                "-onum_clusters_features_dc=512",
                "-on_bits_proposal_features_dc=n_bits_proposal_balanced_values(7)",
                "-onum_clusters_features_rest=[256, 128, 64]",
                "-on_bits_proposal_features_rest=[n_bits_proposal_balanced_values(6), n_bits_proposal_balanced_values(5), n_bits_proposal_balanced_values(4)]",
            ]
        },
        {
            "name": "render",
            "type": "debugpy",
            "request": "launch",
            "module": "cags.render",
            "console": "integratedTerminal",
            "justMyCode": false,
            "args": [
                "-s",
                "data/coffee_martini/frame1",
                "-d",
                "output/coffee_martini/frame1",
                "-i",
                "10000",
                "--mode",
                "base",
                "--load_camera",
                "output/coffee_martini/frame1/cameras.json",
            ]
        },
        {
            "name": "warping",
            "type": "debugpy",
            "request": "launch",
            "module": "prpa",
            "console": "integratedTerminal",
            "justMyCode": false,
            "args": [
                "--local",
                "output/coffee_martini/frame1/ours_10000/renders/00006",
                "--reference",
                "output/coffee_martini/frame1/ours_10000/renders/00005",
                "--warped",
                "output/coffee_martini/frame1/ours_10000/wraped/00006",
                "--debug"
            ]
        },
        {
            "name": "compare ply",
            "type": "debugpy",
            "request": "launch",
            "program": "tools/compare_ply.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "args": [
                "output/truck-scalable/point_cloud/iteration_30000",
            ]
        },
        {
            "name": "draco to 3dgs",
            "type": "debugpy",
            "request": "launch",
            "program": "tools/draco_to_3dgs.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "args": [
                "-d",
                "output/truck-draco",
                "--sh_degree",
                "3",
                "--iteration",
                "30000",
            ]
        },
    ]
}