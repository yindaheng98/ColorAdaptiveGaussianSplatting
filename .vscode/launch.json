{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "train",
            "type": "debugpy",
            "request": "launch",
            "module": "reduced_3dgs.train",
            "console": "integratedTerminal",
            "justMyCode": false,
            "args": [
                "-s",
                "data/truck",
                "-d",
                "output/truck-reduced",
                "-i",
                "30000",
                "--mode",
                "densify-prune-shculling",
            ]
        },
        {
            "name": "quantize",
            "type": "debugpy",
            "request": "launch",
            "module": "reduced_3dgs.quantize",
            "console": "integratedTerminal",
            "justMyCode": false,
            "args": [
                "-s",
                "output/truck-reduced",
                "-d",
                "output/truck-quantized",
                "-i",
                "30000",
                "--num_clusters_scaling=1024",
                "--num_clusters_rotation_re=256",
                "--num_clusters_rotation_im=1024",
                "--num_clusters_opacity=256",
                "--num_clusters_features_dc=512",
                "--num_clusters_features_rest=256",
            ]
        },
        {
            "name": "scalable quantize",
            "type": "debugpy",
            "request": "launch",
            "module": "cags.quantize",
            "console": "integratedTerminal",
            "justMyCode": false,
            "args": [
                "-s",
                "output/truck",
                "-d",
                "output/truck-scalable",
                "-i",
                "30000",
                "-onum_clusters_scaling=1024",
                "-onum_clusters_rotation_re=256",
                "-onum_clusters_rotation_im=1024",
                "-onum_clusters_opacity=256",
                "-onum_clusters_features_dc=512",
                "-onum_clusters_features_rest=[256, 128, 64]",
            ]
        },
        {
            "name": "scalable quantize reduced",
            "type": "debugpy",
            "request": "launch",
            "module": "cags.quantize",
            "console": "integratedTerminal",
            "justMyCode": false,
            "args": [
                "-s",
                "output/truck-reduced",
                "-d",
                "output/truck-scalable",
                "-i",
                "30000",
                "-onum_clusters_scaling=1024",
                "-onum_clusters_rotation_re=256",
                "-onum_clusters_rotation_im=1024",
                "-onum_clusters_opacity=256",
                "-onum_clusters_features_dc=512",
                "-onum_clusters_features_rest=[256, 128, 64]",
            ]
        },
    ]
}