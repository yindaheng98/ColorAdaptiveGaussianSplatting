{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "train",
            "type": "debugpy",
            "request": "launch",
            "module": "reduced_3dgs.train",
            "console": "integratedTerminal",
            "justMyCode": false,
            "args": [
                "-s",
                "data/truck",
                "-d",
                "output/truck-reduced",
                "-i",
                "30000",
                "--mode",
                "camera-densify-prune-shculling",
            ]
        },
        {
            "name": "scalable quantize",
            "type": "debugpy",
            "request": "launch",
            "module": "cags.quantize",
            "console": "integratedTerminal",
            "justMyCode": false,
            "args": [
                "-s",
                "output/truck-reduced",
                "-d",
                "output/truck-scalable",
                "-i",
                "30000",
                "--draco",
                "-onum_clusters_scaling=1024",
                "-on_bits_proposal_scaling=n_bits_proposal_balanced_values(8)",
                "-onum_clusters_rotation_re=256",
                "-on_bits_proposal_rotation_re=n_bits_proposal_balanced_values(6)",
                "-onum_clusters_rotation_im=1024",
                "-on_bits_proposal_rotation_im=n_bits_proposal_balanced_values(8)",
                "-onum_clusters_opacity=256",
                "-on_bits_proposal_opacity=n_bits_proposal_balanced_values(6)",
                "-onum_clusters_features_dc=512",
                "-on_bits_proposal_features_dc=n_bits_proposal_balanced_values(7)",
                "-onum_clusters_features_rest=[256, 128, 64]",
                "-on_bits_proposal_features_rest=[n_bits_proposal_balanced_values(6), n_bits_proposal_balanced_values(5), n_bits_proposal_balanced_values(4)]",
            ]
        },
        {
            "name": "scalable dequantize",
            "type": "debugpy",
            "request": "launch",
            "module": "cags.quantize",
            "console": "integratedTerminal",
            "justMyCode": false,
            "args": [
                "-s",
                "output/truck-reduced",
                "-d",
                "output/truck-scalable",
                "-i",
                "30000",
                "--draco",
                "--dequantize",
            ]
        },
        {
            "name": "tile",
            "type": "debugpy",
            "request": "launch",
            "module": "cags.tile",
            "console": "integratedTerminal",
            "justMyCode": false,
            "args": [
                "-s",
                "output/truck-reduced",
                "-d",
                "output/truck-scalable-tiles",
                "-i",
                "30000",
                "--draco",
                "-onum_clusters_scaling=1024",
                "-on_bits_proposal_scaling=n_bits_proposal_balanced_values(8)",
                "-onum_clusters_rotation_re=256",
                "-on_bits_proposal_rotation_re=n_bits_proposal_balanced_values(6)",
                "-onum_clusters_rotation_im=1024",
                "-on_bits_proposal_rotation_im=n_bits_proposal_balanced_values(8)",
                "-onum_clusters_opacity=256",
                "-on_bits_proposal_opacity=n_bits_proposal_balanced_values(6)",
                "-onum_clusters_features_dc=512",
                "-on_bits_proposal_features_dc=n_bits_proposal_balanced_values(7)",
                "-onum_clusters_features_rest=[256, 128, 64]",
                "-on_bits_proposal_features_rest=[n_bits_proposal_balanced_values(6), n_bits_proposal_balanced_values(5), n_bits_proposal_balanced_values(4)]",
            ]
        },
        {
            "name": "stitch",
            "type": "debugpy",
            "request": "launch",
            "module": "cags.tile",
            "console": "integratedTerminal",
            "justMyCode": false,
            "args": [
                "-s",
                "output/truck-reduced",
                "-d",
                "output/truck-scalable-tiles",
                "-i",
                "30000",
                "--draco",
                "--stitching",
            ]
        },
        {
            "name": "encode",
            "type": "debugpy",
            "request": "launch",
            "module": "cags.encode",
            "console": "integratedTerminal",
            "justMyCode": false,
            "args": [
                "-s",
                "output/discussion/refine/masked-propagate-dot-cotracker3",
                "-d",
                "output/discussion-compressed/refine/masked-propagate-dot-cotracker3",
                "-i",
                "1000",
                "--source_init",
                "output/discussion/frame1",
                "--destination_init",
                "output/discussion-compressed/frame1",
                "--iteration_init",
                "10000",
                "--frame_start",
                "2",
                "--frame_end",
                "300",
            ]
        },
        {
            "name": "compare ply",
            "type": "debugpy",
            "request": "launch",
            "program": "tools/compare_ply.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "args": [
                "output/truck-scalable/point_cloud/iteration_30000",
            ]
        },
        {
            "name": "draco to 3dgs",
            "type": "debugpy",
            "request": "launch",
            "program": "tools/draco_to_3dgs.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "args": [
                "-d",
                "output/truck-draco",
                "--sh_degree",
                "3",
                "--iteration",
                "30000",
            ]
        },
    ]
}